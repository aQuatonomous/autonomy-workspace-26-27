<?xml version='1.0'?>
<sdf version='1.6'>
  <!-- Taylor Made Sur-Mark 950410 (port, red): 18 in diameter, 39 in above the waterline.
       Anchored (static); the model origin is the waterline. -->
  <model name='Red Surmark Buoy'>
    <static>true</static>
    <link name="base_link">
      <visual name="visual">
        <pose>0 0 -0.254 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RedSurMark/meshes/RedSurmark.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <!-- Overrides the mesh's dark Collada colour; same colours as the other course models,
             semi-gloss polyethylene. -->
        <material>
          <ambient>0.850 0.050 0.050 1</ambient>
          <diffuse>0.850 0.050 0.050 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr><metal><metalness>0</metalness><roughness>0.5</roughness></metal></pbr>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.3683 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2286</radius>
            <length>1.2446</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
