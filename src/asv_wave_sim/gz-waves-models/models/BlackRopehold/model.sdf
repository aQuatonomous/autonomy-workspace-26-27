<?xml version='1.0'?>
<sdf version='1.6'>
  <!-- Polyform A-0 (Black): 20.3 cm diameter, 0.5 ft above the waterline.
       Anchored (static); the model origin is the waterline. -->
  <model name='Black Ropehold Buoy'>
    <static>true</static>
    <link name="base_link">
      <visual name="visual">
        <pose>0 0 -0.0254 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://BlackRopehold/meshes/BlackRopehold.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 -0.0254 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.1016</radius>
          </sphere>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
