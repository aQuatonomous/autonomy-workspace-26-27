<sdf version="1.9">
  <model name="ourboat">
    <link name="base_link">
      <inertial>
        <pose>-0.05 0 -0.15 0 0 0</pose>
        <mass>30.0</mass>
        <inertia>
          <ixx>2.42369</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.9235025</iyy>
          <iyz>0</iyz>
          <izz>5.6403125</izz>
        </inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry>
          <mesh>
            <uri>models://ourboat/meshes/blueboat_hull_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="hull_visual">
        <geometry>
          <mesh>
            <uri>models://ourboat/meshes/blueboat_hull_collision.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
          <ambient>1 0 1 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- Safe primitive visuals restore the missing bridge/deck silhouette
           without relying on the crash-prone COLLADA meshes. -->
      <visual name="deck_visual">
        <pose>0.05 0 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>1.18 0.62 0.06</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.07 0.07 0.08 1</diffuse>
          <ambient>0.07 0.07 0.08 1</ambient>
          <specular>0.2 0.2 0.2 1</specular>
          <pbr>
            <metal>
              <metalness>0.3</metalness>
              <roughness>0.75</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="fore_crossbeam_visual">
        <pose>0.34 0 0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.80 0.08</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.12 0.12 0.13 1</diffuse>
          <ambient>0.12 0.12 0.13 1</ambient>
          <specular>0.2 0.2 0.2 1</specular>
          <pbr>
            <metal>
              <metalness>0.6</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="aft_crossbeam_visual">
        <pose>-0.31 0 0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.80 0.08</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.12 0.12 0.13 1</diffuse>
          <ambient>0.12 0.12 0.13 1</ambient>
          <specular>0.2 0.2 0.2 1</specular>
          <pbr>
            <metal>
              <metalness>0.6</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="console_visual">
        <pose>0.08 0 0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.18 0.26</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.16 0.16 0.17 1</diffuse>
          <ambient>0.16 0.16 0.17 1</ambient>
          <specular>0.25 0.25 0.25 1</specular>
          <pbr>
            <metal>
              <metalness>0.4</metalness>
              <roughness>0.55</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="mast_visual">
        <pose>0.2 0 0.42 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.42</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.85 0.85 0.87 1</diffuse>
          <ambient>0.85 0.85 0.87 1</ambient>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="flag_visual_safe">
        <pose>0.27 0 0.53 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.01 0.08</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.95 0.82 0.08 1</diffuse>
          <ambient>0.95 0.82 0.08 1</ambient>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- DAE visuals commented out due to ColladaLoader crash - hull STL provides basic visualization -->
      <!--
      <visual name="aerial_visual">
        <geometry>
          <mesh>
            <uri>models://ourboat/meshes/blueboat_aerial.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
