# Machine-specific locations for the simulator scripts. Every value can be overridden by
# exporting it before running a script, or by writing the same lines into config.local.env
# (gitignored) next to this file. setup_sim.sh installs everything at these defaults.

: "${ROS_SETUP:=/opt/ros/jazzy/setup.bash}"
: "${ARDUPILOT_DIR:=$HOME/ardupilot}"            # ArduPilot checkout (SITL: Tools/autotest/sim_vehicle.py)
: "${ARDUPILOT_VENV:=$HOME/venv-ardupilot}"      # Python venv made by ArduPilot's install-prereqs-ubuntu.sh
: "${ARDUPILOT_GAZEBO_DIR:=$HOME/ardupilot_gazebo}"  # ArduPilotPlugin build (build/libArduPilotPlugin.so)
: "${SITL_MODELS_DIR:=$HOME/SITL_Models}"        # optional extra Gazebo models (not needed for the course)
: "${ROBOCOMMAND_HOST:=10.10.10.1}"              # where message_node sends reports (competition RoboCommand)
: "${ROBOCOMMAND_PORT:=50000}"
: "${CV_ENGINE_CACHE:=$HOME/.cache/aquatonomous/engines}"  # per-GPU TensorRT engines (build_engines.sh)
# protobuf runtime matching message_node's report_pb2.py (generated with protobuf 6.32); used only
# on message_node's PYTHONPATH because Ubuntu's python3-protobuf (4.21) cannot load that code.
: "${MESSAGE_NODE_PYDEPS:=$HOME/.cache/aquatonomous/message_node_pydeps}"
