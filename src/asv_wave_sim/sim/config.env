# Machine-specific locations for the simulator scripts. Every value can be overridden by
# exporting it before running a script, or by writing the same lines into config.local.env
# (gitignored) next to this file. setup_sim.sh installs everything at these defaults.

: "${ROS_SETUP:=/opt/ros/jazzy/setup.bash}"
# Shared machine: setup_shared.sh moves ArduPilot, its venv, the Gazebo plugin and the caches into
# one copy under AQUA_SHARED for every account. When that exists it is the default; otherwise each
# account has its own under $HOME.
: "${AQUA_SHARED:=/opt/aqua}"
if [ -x "$AQUA_SHARED/ardupilot/build/sitl/bin/ardurover" ]; then
  _aqua_tools="$AQUA_SHARED" _aqua_cache="$AQUA_SHARED/cache"
else
  _aqua_tools="$HOME" _aqua_cache="$HOME/.cache/aquatonomous"
fi
: "${ARDUPILOT_DIR:=$_aqua_tools/ardupilot}"            # ArduPilot checkout (SITL: Tools/autotest/sim_vehicle.py)
: "${ARDUPILOT_VENV:=$_aqua_tools/venv-ardupilot}"      # Python venv made by ArduPilot's install-prereqs-ubuntu.sh
: "${ARDUPILOT_GAZEBO_DIR:=$_aqua_tools/ardupilot_gazebo}"  # ArduPilotPlugin build (build/libArduPilotPlugin.so)
: "${SITL_MODELS_DIR:=$HOME/SITL_Models}"        # optional extra Gazebo models (not needed for the course)
: "${SIM_CAMERA:=960x600@15}"                     # boat cameras WIDTHxHEIGHT@HZ; the real cameras are 1920x1200@30
: "${SIM_LABEL_RATE:=2}"                          # autolabel bounding-box cameras (select_course.sh --labels), Hz
: "${ROBOCOMMAND_HOST:=10.10.10.1}"              # where message_node sends reports (competition RoboCommand)
: "${ROBOCOMMAND_PORT:=50000}"
: "${GZ_PARTITION:=$USER}"                       # Gazebo topics; per user so sims on a shared machine stay apart
: "${ROS_DOMAIN_ID:=$(( $(id -u) % 100 + 1 ))}"  # same for ROS 2 (1-100 from the user id; 0 stays the default)
: "${FOXGLOVE_PORT:=$(( 8700 + $(id -u) % 100 ))}"  # foxglove_bridge (9_foxglove.sh); per user as well
: "${CV_ENGINE_CACHE:=$_aqua_cache/engines}"  # per-GPU TensorRT engines (build_engines.sh)
# protobuf runtime matching message_node's report_pb2.py (generated with protobuf 6.32); used only
# on message_node's PYTHONPATH because Ubuntu's python3-protobuf (4.21) cannot load that code.
: "${MESSAGE_NODE_PYDEPS:=$_aqua_cache/message_node_pydeps}"
unset _aqua_tools _aqua_cache
