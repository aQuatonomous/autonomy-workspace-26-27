<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>truth_scorer</name>
  <version>0.1.0</version>
  <description>Calibrated existence, class and position confidence for mapped course objects, with an answer-key evaluator.</description>
  <maintainer email="dev@aquatonomous.ca">aQuatonomous</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>pointcloud_filters</depend>
  <depend>global_frame</depend>
  <depend>truth_scorer_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
